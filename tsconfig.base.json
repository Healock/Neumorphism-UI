{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@healock/neumorphism-ui": ["./packages/neumorphism-ui/src/index.ts"],
      "@healock/neumorphism-ui/preset": ["./packages/neumorphism-ui/src/preset.ts"],
      "@healock/neumorphism-ui/theme": ["./packages/neumorphism-ui/src/theme.ts"]
    }
  }
}
